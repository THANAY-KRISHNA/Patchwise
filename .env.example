# Environment Configuration Template for Patchwise
# Copy this file to .env and adjust values for local development.
# NEVER commit actual secrets or the .env file to version control.

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (Async PostgreSQL)
# Example: postgresql+asyncpg://<username>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patchwise

# GitHub Integration (Optional for public rate limits up to 60/hr; required for 5,000/hr)
# Generate a Personal Access Token with read-only repository scope:
GITHUB_TOKEN=

# AI Provider Configuration ('none', 'openai', 'anthropic', 'gemini', 'ollama')
# Setting LLM_PROVIDER=none runs the system purely in deterministic Rule-Only mode (0 cost, offline capable)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Review Bounds & Limits
MAX_FILES_PER_REVIEW=20
MAX_PATCH_CHARS=80000

# CORS Allowed Origins (JSON array or comma-separated list of origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
